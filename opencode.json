{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "list": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow"
  },
  "mcp": {
    "bun-docs": {
      "type": "remote",
      "url": "https://bun.com/docs/mcp"
    },
    "svelte": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@sveltejs/mcp"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  },
  "plugin": [
		"@sveltejs/opencode@0.1.9"
	]
}