{
  "name": "even-pf",
  "version": "0.5.2",
  "description": "AI-assisted responsible grading tool for programming assignments",
  "module": "src/hosts/local-api-host.ts",
  "type": "module",
  "exports": {
    ".": "./src/hosts/local-api-host.ts"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "bun run src/hosts/cli-host.ts",
    "migrate": "bun run src/hosts/cli-host.ts migrate",
    "build:dev": "bun build src/hosts/cli-host.ts --compile --outfile build/epf",
    "build:all": "bun scripts/build-all.ts",
    "publish:all": "bun scripts/publish-all.ts",
    "publish:dry": "bun scripts/publish-all.ts --dry-run",
    "bump": "bun scripts/bump-version.ts",
    "config-gen": "bun run --console-depth 6 src/generate-config.ts",
    "check": "bun x tsc --noEmit"
  },
  "bin": {
    "even-pf": "bin/even-pf.js",
    "e-pf": "src/hosts/cli-host.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/openai": "^3.0.73",
    "ai": "^6.0.208",
    "chalk": "^5.6.2",
    "smol-toml": "^1.6.1",
    "zod-defaults": "^0.2.3"
  },
  "optionalDependencies": {
    "even-pf-linux-x64": "0.5.2",
    "even-pf-linux-arm64": "0.5.2",
    "even-pf-windows-x64": "0.5.2",
    "even-pf-darwin-x64": "0.5.2",
    "even-pf-darwin-arm64": "0.5.2"
  },
  "files": [
    "bin/even-pf.js",
    "package.json",
    "README.md",
    ".gitignore",
    "src",
    "bun.lock",
    "bunfig.toml",
    "epf.example.toml",
    "tsconfig.json"
  ]
}
